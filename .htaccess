# Cheerplex - Apache URL Rewriting (.htaccess)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Enforce trailing slash for non-file, non-api requests to avoid redirects
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ /$1/ [L,R=301]

    # Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route public static assets
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Forward all requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security Headers & Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
